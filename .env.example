# Port the server listens on
PORT=3000
# SQLite file path (Docker uses /data/tuesday.db)
DATABASE_PATH=./data/tuesday.db
# Public URL of the app, used in invite links and the OpenRouter HTTP-Referer header
APP_URL=http://localhost:3000
# Set to true when served over HTTPS
COOKIE_SECURE=false
# fatal | error | warn | info | debug
LOG_LEVEL=info
# OpenRouter API key (https://openrouter.ai/keys). Leave empty to run without AI.
OPENROUTER_API_KEY=
# Defaults until an admin picks models in Admin → AI. Alternative: z-ai/glm-5.3-flashx
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_FAST_MODEL=deepseek/deepseek-v4.1-flash-1017
# Development/testing only: true = built-in fake AI, no key, no cost. Never set in production.
AI_FAKE=false
# Where uploaded files are stored (Docker: /data/uploads)
UPLOADS_DIR=./data/uploads
# Maximum upload size in megabytes
MAX_UPLOAD_MB=25
# Where automatic and manual backups are written (Docker: /data/backups)
BACKUP_DIR=./data/backups
# How many automatic daily backups to keep (0 disables automatic backups)
BACKUP_KEEP=7
# Hour (0-23, organization timezone) for the automatic daily backup
BACKUP_HOUR=3
# Allow webhooks to private/loopback addresses (only for trusted networks)
WEBHOOKS_ALLOW_PRIVATE=false

# Outgoing email (SMTP). Purelymail: host smtp.purelymail.com, port 465 (SSL/TLS), fallback 587 (STARTTLS)
SMTP_HOST=
SMTP_PORT=465
# true = implicit TLS (465). Defaults to true when SMTP_PORT is 465, else false
SMTP_SECURE=
# Port tried once with STARTTLS if the first connection fails (0 disables)
SMTP_FALLBACK_PORT=587
# Full email address of the mailbox
SMTP_USER=
SMTP_PASS=
# From header, e.g. Tuesday <tuesday@yourdomain.com>. Defaults to "Tuesday <SMTP_USER>"
MAIL_FROM=
# Development/testing only: capture emails instead of sending them. Never set in production.
MAIL_FAKE=false

# Single sign-on (OpenID Connect). Redirect URI to register: {APP_URL}/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_BUTTON_LABEL=Sign in with SSO
# Comma-separated email domains that may join without an invite (empty = invite only)
OIDC_ALLOWED_DOMAINS=
# Role for people who join through an allowed domain: member or viewer
OIDC_DEFAULT_ROLE=member
# true = hide password sign-in for everyone except the owner
OIDC_ONLY=false
# true when Tuesday runs behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# Web push (optional). Empty = Tuesday generates keys on first start and keeps them in the database
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@yourdomain.com
VAPID_SUBJECT=
# Development/testing only: record push messages instead of sending them
PUSH_FAKE=false
# Off-site backups to S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO, Wasabi)
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=tuesday/
BACKUP_S3_KEEP=30
# Development/testing only: write off-site copies to ./data/fake-s3 instead of S3
BACKUP_S3_FAKE=false
# Encrypts off-site backups (AES-256-GCM). At least 32 characters.
BACKUP_ENCRYPTION_KEY=
# Bearer token for /api/health/deep and /api/metrics (monitoring tools). Empty = admins only
HEALTH_TOKEN=
