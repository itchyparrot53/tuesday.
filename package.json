{
  "name": "tuesday",
  "version": "0.1.0",
  "description": "Self-hosted work OS with boards, docs, dashboards, automations and optional AI.",
  "license": "MIT",
  "author": "Tuesday contributors",
  "homepage": "https://github.com/itchyparrot53/tuesday.#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/itchyparrot53/tuesday..git"
  },
  "bugs": {
    "url": "https://github.com/itchyparrot53/tuesday./issues"
  },
  "keywords": [
    "self-hosted",
    "work-management",
    "project-management",
    "monday-alternative",
    "kanban",
    "sqlite",
    "fastify",
    "react",
    "typescript",
    "docker",
    "pwa",
    "ai"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "npm run build && playwright test",
    "check:colors": "node scripts/check-colors.mjs",
    "design:gallery": "node scripts/build-design-gallery.mjs",
    "check:progress": "node scripts/check-progress.mjs",
    "check:design": "node scripts/check-design.mjs",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.7",
    "openid-client": "^6.8.8",
    "papaparse": "^5.7.0",
    "remark-gfm": "^4.0.1",
    "undici": "^8.12.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.5",
    "date-fns": "^4.4.0",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.6",
    "idb": "^8.0.4",
    "lucide-react": "^1.59.0",
    "oauth2-mock-server": "^9.3.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
